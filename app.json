{
  "expo": {
    "name": "SeedScan",
    "slug": "SeedScan",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "seedscan",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "assetBundlePatterns": ["**/*"],

    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": { "backgroundColor": "#000000" }
        }
      ],
      "expo-secure-store",
      "expo-asset",
      "expo-web-browser",

      /* ВАЖНО: камера и галерея */
      [
        "expo-image-picker",
        {
          "photosPermission": "Доступ к фото, чтобы выбирать снимки.",
          "cameraPermission": "Доступ к камере, чтобы делать снимки."
        }
      ],
      "expo-media-library" /* для saveToLibraryAsync */
    ],

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.SeedScan",
      "infoPlist": {
        "NSCameraUsageDescription": "Нужно, чтобы сделать фото.",
        "NSPhotoLibraryUsageDescription": "Нужно, чтобы выбрать фото из галереи.",
        "NSPhotoLibraryAddUsageDescription": "Нужно, чтобы сохранять снимки в галерею."
      }
    },

    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.SeedScan"
      /* Плагин expo-image-picker сам добавит нужные runtime-пермишены
         (READ_MEDIA_IMAGES/READ_EXTERNAL_STORAGE/CAMERA) в AndroidManifest
         при dev-сборке. Ничего вручную сюда пихать не надо. */
    },

    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
